# --- watering_controller.py only ---------------------------------------------
# Hard cap applied to every command regardless of what the backend asks for.
MAX_WATERING_DURATION_SEC=120
# How many pumps may run at once. The relay board and pumps share one supply,
# so 1 unless that supply is known to source more.
MAX_CONCURRENT_RELAYS=1
# Tank lockout. 0 disables it, which is correct today: no water-level sensor is
# wired. To enable, set the minimum percentage AND the MCP3008 channel it is on.
TANK_MIN_PCT=0
# TANK_ADC_CHANNEL=6
