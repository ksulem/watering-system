DB_PASSWORD=changeme
MQTT_CONSUMER_PASSWORD=changeme
MQTT_DISPATCHER_PASSWORD=changeme

# Telegram. Blank until the bot is created via @BotFather (Phase 6).
# While BOT_TOKEN/OWNER_USER_ID are unset the Consumer records alerts without
# pushing them, and the API's /auth/session returns 503 with every other
# endpoint locked.
BOT_TOKEN=
OWNER_CHAT_ID=
# Numeric Telegram user id of the single owner — the only account the API will
# issue a session to. Same value as OWNER_CHAT_ID for a 1:1 chat.
OWNER_USER_ID=

# Signing key for API session tokens, independent of BOT_TOKEN so rotating the
# bot doesn't invalidate sessions (and vice versa). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Comma-separated origins allowed to call the API from a browser. Leave blank
# until the Mini App is actually served from somewhere. Once a domain exists
# this is https://<DOMAIN>.
CORS_ORIGINS=

# Public domain, pointed at this VPS with a DNS A record. Required before nginx
# can start or a certificate can be issued — Telegram will not deliver webhooks
# or load a Mini App over anything but valid HTTPS.
DOMAIN=
# Address Let's Encrypt sends expiry warnings to.
LETSENCRYPT_EMAIL=

# Telegram echoes this back in X-Telegram-Bot-Api-Secret-Token on every webhook
# delivery, and the bot rejects anything that doesn't match. Required: /webhook
# on a known domain is trivially guessable, so without it anyone could post
# forged updates. Generate with:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# Set once the Mini App is served (Phase 7), e.g. https://<DOMAIN>/app. While
# empty the bot hides its dashboard button rather than linking to a 404.
MINI_APP_URL=
